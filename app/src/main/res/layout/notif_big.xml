<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded reminder: the app's ink-and-gold prayer card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/notif_card">

    <ImageView
        android:id="@+id/n_ornament"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/n_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_medium"
            android:maxLines="1"
            android:textColor="#D6B370"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/n_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/reem_kufi_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#F3EFE6"
                android:textSize="30sp" />
            <TextView
                android:id="@+id/n_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/plex_semibold"
                android:maxLines="1"
                android:textColor="#D6B370"
                android:textSize="15sp" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/n_count_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/n_count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plex_regular"
                    android:textColor="#9AA3B2"
                    android:textSize="11sp" />
                <Chronometer
                    android:id="@+id/n_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plex_semibold"
                    android:includeFontPadding="false"
                    android:layoutDirection="ltr"
                    android:textColor="#F3EFE6"
                    android:textSize="26sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/n_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/plex_regular"
            android:maxLines="2"
            android:textColor="#B9C0CC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/n_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/notif_row_bg"
            android:fontFamily="@font/amiri_regular"
            android:lineSpacingExtra="2dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="#EDE4CF"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/n_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/notif_row_bg"
            android:orientation="horizontal"
            android:padding="4dp">
            <LinearLayout android:id="@+id/n_cell_0" style="@style/NCell"><TextView android:id="@+id/n_name_0" style="@style/NCellName" /><TextView android:id="@+id/n_ptime_0" style="@style/NCellTime" /></LinearLayout>
            <LinearLayout android:id="@+id/n_cell_1" style="@style/NCell"><TextView android:id="@+id/n_name_1" style="@style/NCellName" /><TextView android:id="@+id/n_ptime_1" style="@style/NCellTime" /></LinearLayout>
            <LinearLayout android:id="@+id/n_cell_2" style="@style/NCell"><TextView android:id="@+id/n_name_2" style="@style/NCellName" /><TextView android:id="@+id/n_ptime_2" style="@style/NCellTime" /></LinearLayout>
            <LinearLayout android:id="@+id/n_cell_3" style="@style/NCell"><TextView android:id="@+id/n_name_3" style="@style/NCellName" /><TextView android:id="@+id/n_ptime_3" style="@style/NCellTime" /></LinearLayout>
            <LinearLayout android:id="@+id/n_cell_4" style="@style/NCell"><TextView android:id="@+id/n_name_4" style="@style/NCellName" /><TextView android:id="@+id/n_ptime_4" style="@style/NCellTime" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
