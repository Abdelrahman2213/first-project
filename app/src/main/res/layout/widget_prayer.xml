<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F3EFE6"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="4dp"
            android:textColor="#D6B370"
            android:textSize="15sp"
            android:textStyle="bold" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <Chronometer
            android:id="@+id/w_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:layoutDirection="ltr"
            android:textColor="#F3EFE6"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_times"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_row_bg"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <LinearLayout style="@style/WidgetCell"><TextView android:id="@+id/w_name_0" style="@style/WidgetName" /><TextView android:id="@+id/w_time_0" style="@style/WidgetTime" /></LinearLayout>
        <LinearLayout style="@style/WidgetCell"><TextView android:id="@+id/w_name_1" style="@style/WidgetName" /><TextView android:id="@+id/w_time_1" style="@style/WidgetTime" /></LinearLayout>
        <LinearLayout style="@style/WidgetCell"><TextView android:id="@+id/w_name_2" style="@style/WidgetName" /><TextView android:id="@+id/w_time_2" style="@style/WidgetTime" /></LinearLayout>
        <LinearLayout style="@style/WidgetCell"><TextView android:id="@+id/w_name_3" style="@style/WidgetName" /><TextView android:id="@+id/w_time_3" style="@style/WidgetTime" /></LinearLayout>
        <LinearLayout style="@style/WidgetCell"><TextView android:id="@+id/w_name_4" style="@style/WidgetName" /><TextView android:id="@+id/w_time_4" style="@style/WidgetTime" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
